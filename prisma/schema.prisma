datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Anime {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  originalTitle  String?
  description    String?
  posterUrl      String?
  backgroundUrl  String?
  year           Int?
  genres         String?
  status         String         @default("ongoing") // ongoing | finished | announced
  type           String         @default("series") // series | movie
  category       String         @default("series") // movie | series | anime
  source         String         @default("manual") // manual | tmdb | kodik | tmdb+kodik
  sourceKey      String?        @unique
  kinopoiskId    String?
  imdbId         String?
  shikimoriId   String?
  videoUrl       String?
  kodikUpdatedAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  seasons        Season[]
  kodikSources   KodikSource[]
  favorites      Favorite[]

  @@index([createdAt])
  @@index([updatedAt])
  @@index([type])
  @@index([category])
  @@index([kinopoiskId])
  @@index([imdbId])
  @@index([shikimoriId])
}

model Season {
  id       String    @id @default(cuid())
  number   Int
  title    String?
  animeId  String
  anime    Anime     @relation(fields: [animeId], references: [id], onDelete: Cascade)
  episodes Episode[]

  @@unique([animeId, number])
}

model Episode {
  id          String   @id @default(cuid())
  number      Int
  title       String?
  videoUrl    String
  duration    Int?
  releaseDate DateTime?
  seasonId    String
  season      Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, number])
}

model Genre {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
  favorites    Favorite[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  animeId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime     Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
  @@index([userId, createdAt])
  @@index([animeId])
}

model SiteSettings {
  id              String   @id @default("global")
  backgroundUrl   String?
  defaultAccent   String   @default("#E8A33D")
  buttonTextColor String   @default("#171208")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model KodikSource {
  id               String   @id @default(cuid())
  animeId          String
  anime            Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)
  kodikId          String
  link             String
  translationId    Int?
  translationTitle String?
  translationType  String?
  quality          String?
  camrip           Boolean  @default(false)
  kodikUpdatedAt   DateTime?
  lastSeason       Int?
  lastEpisode      Int?
  episodesCount    Int?
  seasonsJson      Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([animeId, kodikId])
  @@index([animeId])
  @@index([kodikId])
  @@index([kodikUpdatedAt])
}
