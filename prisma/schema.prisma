generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Anime {
  id             String          @id @default(cuid())
  slug           String          @unique
  title          String
  description    String?
  posterUrl      String?
  backgroundUrl  String?
  year           Int?
  genres         String?
  status         String          @default("ongoing")
  type           String          @default("series")
  videoUrl       String?
  createdAt      DateTime        @default(now())
  category       String          @default("series")
  source         String          @default("manual")
  sourceKey      String?         @unique
  updatedAt      DateTime        @default(now()) @updatedAt
  originalTitle  String?
  kinopoiskId    String?
  imdbId         String?
  shikimoriId    String?
  kodikUpdatedAt DateTime?
  favorites      Favorite[]
  kodikSources   KodikSource[]
  seasons        Season[]
  watchProgress  WatchProgress[]

  @@index([createdAt])
  @@index([updatedAt])
  @@index([type])
  @@index([category])
  @@index([kinopoiskId])
  @@index([imdbId])
  @@index([shikimoriId])
}

model Season {
  id       String    @id @default(cuid())
  number   Int
  title    String?
  animeId  String
  episodes Episode[]
  anime    Anime     @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([animeId, number])
}

model Episode {
  id          String    @id @default(cuid())
  number      Int
  title       String?
  videoUrl    String
  duration    Int?
  releaseDate DateTime?
  seasonId    String
  season      Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, number])
}

model Genre {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  passwordHash  String
  createdAt     DateTime        @default(now())
  favorites     Favorite[]
  sessions      Session[]
  watchProgress WatchProgress[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  animeId   String
  createdAt DateTime @default(now())
  anime     Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
  @@index([userId, createdAt])
  @@index([animeId])
}

model WatchProgress {
  id              String   @id @default(cuid())
  userId          String
  animeId         String
  seasonNumber    Int      @default(0)
  episodeNumber   Int      @default(0)
  positionSeconds Int      @default(0)
  durationSeconds Int?
  completed       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  anime           Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId, seasonNumber, episodeNumber])
  @@index([userId, updatedAt])
  @@index([animeId])
}

model SiteSettings {
  id              String   @id
  backgroundUrl   String?
  defaultAccent   String   @default("#E8A33D")
  buttonTextColor String   @default("#171208")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model KodikSource {
  id               String    @id @default(cuid())
  animeId          String
  kodikId          String
  link             String
  translationId    Int?
  translationTitle String?
  translationType  String?
  quality          String?
  camrip           Boolean   @default(false)
  kodikUpdatedAt   DateTime?
  lastSeason       Int?
  lastEpisode      Int?
  episodesCount    Int?
  seasonsJson      Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  anime            Anime     @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([animeId, kodikId])
  @@index([animeId])
  @@index([kodikId])
  @@index([kodikUpdatedAt])
}
