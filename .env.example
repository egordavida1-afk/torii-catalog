# PostgreSQL. Для Neon можно взять pooled URL как DATABASE_URL и прямой URL как DIRECT_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Администратор.
ADMIN_USER="admin"
ADMIN_PASSWORD="change-this-password-please"
ADMIN_SECRET="replace-with-a-random-secret-at-least-24-characters"

# Автозагрузка каталога. Значения хранятся только на сервере, не добавляй реальные токены в Git.
KODIK_API_TOKEN="paste-your-authorized-kodik-api-token"
KODIK_API_BASE="https://kodik-api.com"
CRON_SECRET="replace-with-a-long-random-cron-secret"
# Сколько страниц каталога Kodik просматривать при синхронизации аниме.
KODIK_ANIME_MAX_PAGES="50"

# AnimeParsers (Python gateway). Local: http://127.0.0.1:8001; production: leave empty to use /api/anime-parsers.
ANIME_PARSERS_API_URL=""
ANIME_PARSERS_SECRET="replace-with-a-random-anime-parser-secret"
