# PostgreSQL. Для Neon можно взять pooled URL как DATABASE_URL и прямой URL как DIRECT_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Администратор. В production обязательно укажи свои значения.
ADMIN_USER="admin"
ADMIN_PASSWORD="change-this-password-please"
ADMIN_SECRET="replace-with-a-random-secret-at-least-24-characters"
